#!/bin/bash
# Installed on the VM as ~/bin/publish-tokens. Reads a gzipped tarball of apps/tokens/dist on stdin,
# unpacks it into a new release and atomically repoints "current" at it. Keeps 5 releases.
# Both the upload (20 MB) and what it unpacks to (60 MB) are capped; a failed upload leaves nothing behind.
set -euo pipefail
ROOT=/home/ubuntu/sites/tokens
NAME=$(date -u +%Y%m%d-%H%M%S)
REL="$ROOT/releases/$NAME"
mkdir -p "$REL" "$ROOT/data"
trap 'rm -rf "$REL"' ERR
head -c 20000000 | gzip -dc | head -c 60000000 | tar -x -C "$REL" --no-same-owner --no-same-permissions
if [ ! -f "$REL/index.html" ]; then rm -rf "$REL"; echo "no index.html in upload" >&2; exit 1; fi
trap - ERR
chmod -R a+rX "$REL"
# Relative link so it also resolves inside the Caddy container (/srv/sites/...).
ln -sfn "releases/$NAME" "$ROOT/current.tmp"
mv -Tf "$ROOT/current.tmp" "$ROOT/current"
ls -1dt "$ROOT"/releases/*/ | tail -n +6 | xargs -r rm -rf
echo "published $NAME"
